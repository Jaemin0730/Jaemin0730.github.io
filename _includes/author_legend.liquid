<div id="author-legend" hidden><span>* Co-first authors · † Corresponding author(s)</span></div>
<style>
  .publication-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  #author-legend {
    margin-left: auto;
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1.5;
    text-transform: none;
    text-align: right;
    opacity: 0.7;
  }
  .publications .row {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 1.5rem;
    margin-left: 0;
    margin-right: 0;
    align-items: start;
  }
  .publications .row > div {
    width: auto;
    max-width: none;
    min-width: 0;
    padding-left: 0;
    padding-right: 0;
  }
  .publications .abbr figure { margin: 0.5rem 0 0; }
  .publications .abbr img.preview {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    aspect-ratio: auto;
    object-fit: contain;
    box-shadow: none;
  }
  @media (max-width: 575px) {
    .publications .row { grid-template-columns: 1fr; gap: 0.75rem; }
    .publications .row > .abbr { width: min(100%, 280px); }
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const legend = document.getElementById('author-legend');
    const selectedLink = document.querySelector('h2 a[href="{{ '/publications/' | relative_url }}"]');
    const heading = selectedLink ? selectedLink.parentElement : document.querySelector('h1.post-title');
    if (heading && legend) {
      heading.classList.add('publication-heading');
      heading.appendChild(legend);
      legend.hidden = false;
    }
  });
</script>
